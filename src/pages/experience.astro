---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import CTASection from "../components/CTASection.astro";
import { experience } from "../data/experience";
---

<BaseLayout
  title="Work Experience | Filippo Marcantoni"
  description="Industry experience across industrial robotics, machine vision, generative AI, automation software, machine activation, and hands-on industrial systems."
>
  <main class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <SectionHeader
      eyebrow="Industry"
      title="Work Experience"
      subtitle="Industry experience across industrial robotics, machine vision, generative AI, automation software, machine activation, and hands-on industrial systems."
    />
    <div class="grid gap-5 md:grid-cols-2">
      {experience.map((item) => <ExperienceCard item={item} />)}
    </div>
  </main>
  <CTASection />
</BaseLayout>
