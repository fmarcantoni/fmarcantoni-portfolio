---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ResearchCard from "../components/ResearchCard.astro";
import CTASection from "../components/CTASection.astro";
import { research } from "../data/research";
---

<BaseLayout
  title="Research | Filippo Marcantoni"
  description="Research work across medical robotics, swarm robotics, VR teleoperation, human-robot interaction, and robotic perception."
>
  <main class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <SectionHeader
      eyebrow="Research"
      title="Research"
      subtitle="Research work across medical robotics, swarm robotics, VR teleoperation, human-robot interaction, and robotic perception."
    />
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {research.map((item) => <ResearchCard item={item} />)}
    </div>
  </main>
  <CTASection />
</BaseLayout>
