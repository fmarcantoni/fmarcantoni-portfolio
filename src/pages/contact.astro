---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Filippo Marcantoni"
  description="Get in touch about robotics engineering, computer vision, robot learning, physical AI, industrial automation, and autonomous systems roles."
>
  <main class="mx-auto max-w-5xl px-5 py-16 lg:px-8">
    <section class="mx-auto max-w-3xl text-center">
      <p class="mb-3 text-sm font-semibold uppercase text-cyan-300">Contact</p>
      <h1 class="text-5xl font-semibold text-white">Contact</h1>
      <p class="mt-5 text-lg leading-8 text-slate-300">
        Interested in robotics engineering, computer vision, robot learning, physical AI, industrial automation, autonomous systems, and robotics software engineering roles.
      </p>
    </section>

    <section class="mt-12 grid gap-5 md:grid-cols-2" aria-label="Contact links">
      <a class="surface focus-ring rounded-lg p-6 transition hover:border-cyan-300/45" href="mailto:filippo.marcantoni@gmail.com">
        <p class="text-sm font-semibold uppercase text-cyan-300">Email</p>
        <p class="mt-3 text-xl font-semibold text-white">filippo.marcantoni@gmail.com</p>
      </a>
      <article class="surface rounded-lg p-6">
        <p class="text-sm font-semibold uppercase text-cyan-300">Location</p>
        <p class="mt-3 text-xl font-semibold text-white">Worcester, MA</p>
      </article>
      <a class="surface focus-ring rounded-lg p-6 transition hover:border-cyan-300/45" href="https://www.linkedin.com/in/filippo-marcantoni-590543264/" target="_blank" rel="noreferrer">
        <p class="text-sm font-semibold uppercase text-cyan-300">LinkedIn</p>
        <p class="mt-3 text-xl font-semibold text-white">linkedin.com/in/filippo-marcantoni-590543264</p>
      </a>
      <a class="surface focus-ring rounded-lg p-6 transition hover:border-cyan-300/45" href="https://github.com/fmarcantoni" target="_blank" rel="noreferrer">
        <p class="text-sm font-semibold uppercase text-cyan-300">GitHub</p>
        <p class="mt-3 text-xl font-semibold text-white">github.com/fmarcantoni</p>
      </a>
    </section>
  </main>
</BaseLayout>
