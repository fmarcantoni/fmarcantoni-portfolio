---
interface Props {
  title?: string;
  text?: string;
}

const {
  title = "Resume and contact",
  text = "Open to roles in robotics engineering, computer vision, robot learning, physical AI, industrial automation, autonomous systems, and robotics software engineering."
} = Astro.props;
---

<section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
  <div class="surface rounded-lg p-8 md:p-10">
    <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <h2 class="text-3xl font-semibold text-white">{title}</h2>
        <p class="mt-4 max-w-3xl text-base leading-7 text-slate-300">{text}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class="focus-ring rounded-md bg-cyan-300 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-200" href="/resume/Filippo-Marcantoni-Resume.pdf">
          Download Resume
        </a>
        <a class="focus-ring rounded-md border border-cyan-300/35 bg-cyan-300/10 px-4 py-3 text-sm font-semibold text-cyan-100 transition hover:bg-cyan-300/16" href="/contact">
          Contact Me
        </a>
      </div>
    </div>
  </div>
</section>
