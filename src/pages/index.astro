---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Card from "../components/Card.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SkillBadge from "../components/SkillBadge.astro";
import CTASection from "../components/CTASection.astro";
import { experience } from "../data/experience";
import { research } from "../data/research";
import { projects } from "../data/projects";
import { skills } from "../data/skills";

const featuredWork = [
  ...experience
    .filter((item) => item.featured)
    .map((item) => ({
      ...item,
      meta: `${item.role} · ${item.organization}`,
      href: `/experience/${item.slug}`
    })),
  ...research
    .filter((item) => item.featured)
    .map((item) => ({
      ...item,
      meta: item.lab,
      href: `/research/${item.slug}`
    })),
  ...projects
    .filter((item) => ["reinforcement-learning", "imitation-learning"].includes(item.slug))
    .map((item) => ({
      ...item,
      meta: item.course,
      href: `/projects/${item.slug}`
    }))
];

const focusAreas = [
  "Robot Perception & 3D Vision",
  "Robot Learning & Physical AI",
  "VR Teleoperation & Human-Robot Interaction",
  "Swarm Robotics & Distributed Systems",
  "Industrial Machine Vision & Automation",
  "Generative AI for Robotics & Automation"
];

const technicalSkillGroups = skills;
---

<BaseLayout
  title="Filippo Marcantoni Portfolio"
  description="Robotics portfolio focused on computer vision, robot learning, physical AI, swarm robotics, VR teleoperation, industrial automation, and autonomous systems."
>
  <main>
    <Hero />

    <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8" aria-labelledby="featured-work">
      <SectionHeader
        eyebrow="Portfolio"
        title="Featured Work"
        subtitle="A focused selection across industry experience, research systems, and graduate robotics projects."
      />
      <div id="featured-work" class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {featuredWork.map((item) => (
          <Card
            type={item.type}
            title={item.title}
            meta={item.meta}
            dates={item.dates}
            summary={item.summary}
            technologies={item.technologies}
            href={item.href}
            image={item.image}
            video={"video" in item ? item.video : undefined}
            imagePosition={"imagePosition" in item ? item.imagePosition : undefined}
          />
        ))}
      </div>
    </section>

    <section class="border-y border-slate-800/80 bg-slate-950/45">
      <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
        <SectionHeader
          title="Technical Focus Areas"
          subtitle="Engineering interests centered on embodied systems that can perceive, learn, reason, and operate in real environments."
        />
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {focusAreas.map((area) => (
            <article class="surface rounded-lg p-5">
              <div class="mb-4 h-1 w-16 rounded-sm bg-cyan-300"></div>
              <h3 class="text-lg font-semibold text-white">{area}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto grid max-w-7xl gap-12 px-5 py-16 lg:grid-cols-2 lg:px-8">
      <div>
        <h2 class="text-3xl font-semibold text-white">Experience Highlights</h2>
        <div class="mt-6 grid gap-4">
          {experience.map((item) => (
            <a class="surface focus-ring rounded-lg p-5 transition hover:border-cyan-300/45" href={`/experience/${item.slug}`}>
              <p class="text-sm font-semibold uppercase text-cyan-300">{item.organization}</p>
              <h3 class="mt-2 text-xl font-semibold text-white">{item.title}</h3>
              <p class="mt-3 text-sm leading-6 text-slate-300">{item.summary}</p>
            </a>
          ))}
        </div>
      </div>
      <div>
        <h2 class="text-3xl font-semibold text-white">Research Highlights</h2>
        <div class="mt-6 grid gap-4">
          {research.map((item) => (
            <a class="surface focus-ring rounded-lg p-5 transition hover:border-cyan-300/45" href={`/research/${item.slug}`}>
              <p class="text-sm font-semibold uppercase text-cyan-300">{item.lab}</p>
              <h3 class="mt-2 text-xl font-semibold text-white">{item.title}</h3>
              <p class="mt-3 text-sm leading-6 text-slate-300">{item.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-slate-800/80 bg-slate-950/45">
      <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
        <SectionHeader
          title="Technical Skills"
          subtitle="Tools, languages, frameworks, and systems used across robotics, computer vision, robot learning, physical AI, automation, and full-stack engineering."
        />
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {technicalSkillGroups.map((group) => (
            <article class="surface rounded-lg p-5">
              <h3 class="text-lg font-semibold text-white">{group.category}</h3>
              <div class="mt-4 flex flex-wrap gap-2">
                {group.skills.map((skill) => <SkillBadge label={skill} />)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <CTASection />
  </main>
</BaseLayout>
