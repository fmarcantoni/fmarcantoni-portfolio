---
import SkillBadge from "./SkillBadge.astro";
import MediaFrame from "./MediaFrame.astro";

interface Props {
  type: string;
  title: string;
  meta?: string;
  dates: string;
  summary: string;
  technologies: string[];
  href: string;
  image?: string;
  video?: string;
  imagePosition?: string;
}

const { type, title, meta, dates, summary, technologies, href, image, video, imagePosition } = Astro.props;
const visibleTech = technologies.slice(0, 6);
const hiddenCount = technologies.length - visibleTech.length;
---

<article class="surface group flex h-full flex-col overflow-hidden rounded-lg transition duration-300 hover:-translate-y-1 hover:border-cyan-300/45">
  <a href={href} class="focus-ring flex h-full flex-col p-6" aria-label={`View details for ${title}`}>
    <div class="mb-5">
      <MediaFrame title={title} image={image} video={video} imagePosition={imagePosition} compact />
    </div>
    <div class="mb-4 flex flex-wrap items-center gap-3">
      <span class="rounded-md border border-cyan-300/25 bg-cyan-300/10 px-2.5 py-1 text-xs font-semibold uppercase text-cyan-200">
        {type}
      </span>
      <span class="text-sm text-slate-400">{dates}</span>
    </div>
    <h3 class="text-xl font-semibold leading-7 text-white transition group-hover:text-cyan-100">{title}</h3>
    {meta && <p class="mt-2 text-sm font-medium text-slate-300">{meta}</p>}
    <p class="mt-4 flex-1 text-sm leading-6 text-slate-300">{summary}</p>
    <div class="mt-5 flex flex-wrap gap-2">
      {visibleTech.map((tech) => <SkillBadge label={tech} />)}
      {hiddenCount > 0 && (
        <span class="inline-flex items-center rounded-md border border-slate-600 bg-slate-800/80 px-2.5 py-1 text-xs font-medium text-slate-300">
          +{hiddenCount}
        </span>
      )}
    </div>
    <span class="mt-6 text-sm font-semibold text-cyan-300 transition group-hover:text-cyan-200">
      View detail
    </span>
  </a>
</article>
